<?xml version="1.0"?>
<sdf version="1.9">
  <world name="mca_gazebo_smoke">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <model name="single_axis_smoke">
      <static>false</static>
      <link name="base">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
      <link name="rotor">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="rotor_collision">
          <geometry><cylinder><radius>0.02</radius><length>0.1</length></cylinder></geometry>
        </collision>
      </link>
      <joint name="axis_joint" type="revolute">
        <parent>base</parent>
        <child>rotor</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper><effort>5</effort><velocity>10</velocity></limit></axis>
      </joint>
      <plugin filename="libmca_gazebo_adapter.so" name="mca_gazebo_adapter::ScalarJointSystem">
        <joint_name>axis_joint</joint_name>
        <!-- CI runs the headless server under variable container scheduling; keep
             the watchdog tolerant of scheduler jitter while the 100 Hz command
             stream is active. This does not change the adapter's runtime default. -->
        <command_timeout_s>0.5</command_timeout_s>
      </plugin>
    </model>
    <!-- Negative configuration fixture: the model exists but the requested
         joint does not. The adapter must emit an actionable diagnostic. -->
    <model name="missing_joint_smoke">
      <static>true</static>
      <link name="base"/>
      <plugin filename="libmca_gazebo_adapter.so" name="mca_gazebo_adapter::ScalarJointSystem">
        <joint_name>joint_that_does_not_exist</joint_name>
      </plugin>
    </model>
    <!-- Negative configuration fixture: required joint_name is omitted. -->
    <model name="missing_joint_name_smoke">
      <static>true</static>
      <link name="base"/>
      <plugin filename="libmca_gazebo_adapter.so" name="mca_gazebo_adapter::ScalarJointSystem"/>
    </model>
  </world>
</sdf>
