<?xml version="1.0"?>
<robot name="mca_two_joint_robot">
  <link name="base"/>
  <link name="link_a"/>
  <link name="link_b"/>

  <joint name="joint_a" type="revolute">
    <parent link="base"/>
    <child link="link_a"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="20"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>

  <joint name="joint_b" type="revolute">
    <parent link="link_a"/>
    <child link="link_b"/>
    <origin xyz="0 0 -1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="20"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>

  <!--
    Jazzy gz_ros2_control obtains the hardware description by subscribing to
    /robot_description. The SDF world defines the physical Gazebo joints;
    this URDF defines the ros2_control resources and custom hardware plugin.
  -->
  <ros2_control name="McaGazeboSystem" type="system">
    <hardware>
      <plugin>mca_gz_ros2_control_adapter/GazeboSystem</plugin>
    </hardware>
    <joint name="joint_a">
      <command_interface name="effort">
        <param name="min">-20</param>
        <param name="max">20</param>
        <param name="initial_value">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_b">
      <command_interface name="effort">
        <param name="min">-20</param>
        <param name="max">20</param>
        <param name="initial_value">0.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
